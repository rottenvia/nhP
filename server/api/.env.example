# ModernPlayer Cloud API server config
# Copy to .env on server:
#   cp .env.example .env
# Generate private server token:
#   openssl rand -hex 32

# ─────────────────────────────────────────────
# Core server access
# ─────────────────────────────────────────────
MODERNPLAYER_SERVER_TOKEN=change_this_to_long_random_string
PUBLIC_BASE_URL=http://YOUR_SERVER_IP_OR_DOMAIN
ENABLE_PUBLIC_HEALTH=true

# Optional future accounts/auth system
# JWT secret: openssl rand -hex 32
AUTH_ENABLED=false
JWT_SECRET=change_this_to_another_long_random_string
DEV_USERNAME=admin
DEV_PASSWORD=change_me
ALLOW_PUBLIC_SIGNUP=false
REQUIRE_EMAIL_VERIFICATION=true
REGISTER_RATE_LIMIT_PER_IP_PER_HOUR=5

# SMTP for email verification. If SMTP_HOST is empty, register returns verification_url for dev testing.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

DEFAULT_USER_DAILY_AI_LIMIT=50
DEFAULT_USER_DAILY_RAW_SEARCH_LIMIT=100
DEV_DAILY_AI_LIMIT=5000

# ─────────────────────────────────────────────
# RAW search / torrent index proxy
# Prowlarr and FlareSolverr should run on the same server via docker-compose.
# Do NOT expose Prowlarr/FlareSolverr ports publicly.
# ─────────────────────────────────────────────
PROWLARR_URL=http://127.0.0.1:9696
PROWLARR_API_KEY=
FLARESOLVERR_URL=http://127.0.0.1:8191

# ─────────────────────────────────────────────
# AI Assistant provider keys
# Keep these on the server so app users do not need keys.json.
# Primary recommended server-side LLM for the app:
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
# Use the model name from your provider dashboard. Official DeepSeek commonly uses deepseek-chat / deepseek-reasoner.
# If your provider labels it DeepSeek V4 Pro, put that exact model id here.
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_MAX_TOKENS_PER_REQUEST=1600
DEEPSEEK_TEMPERATURE=0.35

# Optional fallback if DeepSeek key is empty or fails:
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_DAILY_BUDGET_USD=2.00
OPENAI_MAX_REQUESTS_PER_USER_PER_DAY=50
OPENAI_MAX_TOKENS_PER_REQUEST=1200

# Internet search for Assistant. This is what gives the AI current/recent info.
TAVILY_API_KEY=
TAVILY_MAX_REQUESTS_PER_USER_PER_DAY=30
TAVILY_SEARCH_DEPTH=advanced
TAVILY_MAX_RESULTS=6

# Optional future AI providers/fallbacks
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=

# ─────────────────────────────────────────────
# Movie/TV metadata
# TMDB v3 API key, NOT the long Read Access Token.
# ─────────────────────────────────────────────
TMDB_API_KEY=
OMDB_API_KEY=
FANART_API_KEY=

# Optional metadata providers
TVDB_API_KEY=
TRAKT_CLIENT_ID=
TRAKT_CLIENT_SECRET=
MDBLIST_API_KEY=
YOUTUBE_API_KEY=

# ─────────────────────────────────────────────
# Anime metadata, mostly keyless
# AniList and Jikan do not require keys for basic use.
# ─────────────────────────────────────────────
ANILIST_ENABLED=true
JIKAN_ENABLED=true
MAL_CLIENT_ID=

# ─────────────────────────────────────────────
# Caching / rate limits
# ─────────────────────────────────────────────
RAW_CACHE_TTL_SECONDS=21600
META_CACHE_TTL_SECONDS=86400
FRANCHISE_GUIDE_CACHE_TTL_SECONDS=86400
RATE_LIMIT_PER_IP_PER_MINUTE=60
RATE_LIMIT_PER_USER_PER_MINUTE=120

# ─────────────────────────────────────────────
# Optional database. MVP can use SQLite.
# For production later: postgresql://user:pass@host:5432/db
# ─────────────────────────────────────────────
DATABASE_URL=sqlite:///./modernplayer.db

# ─────────────────────────────────────────────
# Optional cloud storage / logs later
# ─────────────────────────────────────────────
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
LOG_LEVEL=info
